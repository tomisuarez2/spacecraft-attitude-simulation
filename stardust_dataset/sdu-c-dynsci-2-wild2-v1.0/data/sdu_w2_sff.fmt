OBJECT          = COLUMN
  NAME          = "INDEX"
  COLUMN_NUMBER = 1
  DATA_TYPE     = ASCII_INTEGER
  START_BYTE    = 1
  BYTES         = 6
  FORMAT        = "I6"
  DESCRIPTION   = "Index of the record in the original SFF file."
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "RECTYPE"
  COLUMN_NUMBER = 2
  DATA_TYPE     = CHARACTER
  START_BYTE    = 9
  BYTES         = 1
  FORMAT        = "A1"
  DESCRIPTION   = "Type of the record: R = reconstructed data."
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "GENTIM"
  COLUMN_NUMBER = 3
  DATA_TYPE     = CHARACTER
  START_BYTE    = 13
  BYTES         = 19
  FORMAT        = "A19"
  DESCRIPTION   = "Record generation time; local computer clock 
                   in calendar format (YYYY-MM-DD HR:MN:SC[.XXX])."
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "STARTTIM"
  COLUMN_NUMBER = 4
  DATA_TYPE     = CHARACTER
  START_BYTE    = 35
  BYTES         = 23
  FORMAT        = "A23"
  DESCRIPTION   = "Data accumulation period start time, Ephemeris 
                   Time in calendar format (YYYY-MM-DD HR:MN:SC.XXX) 
                   format. This is the time when the telemetry 
                   packet containing data for this SFF record was 
                   opened. It does not necessarily correspond to 
                   the beginning of any of the actual firings 
                   recorded in the packet."
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "STOPTIM"
  COLUMN_NUMBER = 5
  DATA_TYPE     = CHARACTER
  START_BYTE    = 61
  BYTES         = 23
  FORMAT        = "A23"
  DESCRIPTION   = "Data accumulation period stop time, Ephemeris Time 
                   in calendar format (YYYY-MM-DD HR:MN:SC.XXX) format. 
                   This is the time when the telemetry packet containing 
                   data for this SFF record was closed. It does not 
                   necessarily correspond to the end of any of the 
                   actual firings recorded in the packet."
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "DTIME"
  COLUMN_NUMBER = 6
  DATA_TYPE     = ASCII_REAL
  START_BYTE    = 86
  BYTES         = 5
  FORMAT        = "F5.3"
  DESCRIPTION   = "Data accumulation period duration (STOPTIM - 
                   STARTTIM), seconds."
  UNIT          = "SECOND"
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "DMASS"
  COLUMN_NUMBER = 7
  DATA_TYPE     = ASCII_REAL
  START_BYTE    = 92
  BYTES         = 8
  FORMAT        = "F8.6"
  DESCRIPTION   = "Delta mass computed from estimated mass flow rate 
                   and thruster on time, kg. Positive value means mass loss."
  UNIT          = "KILOGRAM"
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "DVX"
  COLUMN_NUMBER = 8
  DATA_TYPE     = ASCII_REAL
  START_BYTE    = 101
  BYTES         = 10
  FORMAT        = "F10.8"
  DESCRIPTION   = "Resultant delta-V in J2000 frame X direction for 
                   the accumulation time period, m/s."
  UNIT          = "METER PER SECOND"
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "DVY"
  COLUMN_NUMBER = 9
  DATA_TYPE     = ASCII_REAL
  START_BYTE    = 112
  BYTES         = 10
  FORMAT        = "F10.8"
  DESCRIPTION   = "Resultant delta-V in J2000 frame Y direction for 
                   the accumulation time period, m/s."
  UNIT          = "METER PER SECOND"
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "DVZ"
  COLUMN_NUMBER = 10
  DATA_TYPE     = ASCII_REAL
  START_BYTE    = 123
  BYTES         = 10
  FORMAT        = "F10.8"
  DESCRIPTION   = "Resultant delta-V in J2000 frame Z direction for 
                   the accumulation time period, m/s."
  UNIT          = "METER PER SECOND"
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "AVG_ATT_QUAT_Q1"
  COLUMN_NUMBER = 11
  DATA_TYPE     = ASCII_REAL
  START_BYTE    = 134
  BYTES         = 9
  FORMAT        = "F9.6"
  DESCRIPTION   = "First element of average attitude quaternion at 
                   time of thruster firings. This quaternion rotates a
                   vector in Earth-Mean-Equator J2000 frame into the
                   spacecraft frame. It follows the convention
                   identified as ``the second system'' in the
                   dictionary definition of the standard PDS keyword
                   QUATERNION_DESC."
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "AVG_ATT_QUAT_Q2"
  COLUMN_NUMBER = 12
  DATA_TYPE     = ASCII_REAL
  START_BYTE    = 144
  BYTES         = 9
  FORMAT        = "F9.6"
  DESCRIPTION   = "Second element of average attitude quaternion at 
                   time of thruster firings. This quaternion rotates a
                   vector in Earth-Mean-Equator J2000 frame into the
                   spacecraft frame. It follows the convention
                   identified as ``the second system'' in the
                   dictionary definition of the standard PDS keyword
                   QUATERNION_DESC."
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "AVG_ATT_QUAT_Q3"
  COLUMN_NUMBER = 13
  DATA_TYPE     = ASCII_REAL
  START_BYTE    = 154
  BYTES         = 9
  FORMAT        = "F9.6"
  DESCRIPTION   = "Third element of average attitude quaternion at 
                   time of thruster firings. This quaternion rotates a
                   vector in Earth-Mean-Equator J2000 frame into the
                   spacecraft frame. It follows the convention
                   identified as ``the second system'' in the
                   dictionary definition of the standard PDS keyword
                   QUATERNION_DESC."
END_OBJECT      = COLUMN

OBJECT          = COLUMN
  NAME          = "AVG_ATT_QUAT_Q4"
  COLUMN_NUMBER = 14
  DATA_TYPE     = ASCII_REAL
  START_BYTE    = 164
  BYTES         = 9
  FORMAT        = "F9.6"
  DESCRIPTION   = "Fourth element of average attitude quaternion at 
                   time of thruster firings (scalar component). This
                   quaternion rotates a vector in Earth-Mean-Equator
                   J2000 frame into the spacecraft frame. It follows
                   the convention identified as ``the second system''
                   in the dictionary definition of the standard PDS
                   keyword QUATERNION_DESC."
END_OBJECT      = COLUMN

